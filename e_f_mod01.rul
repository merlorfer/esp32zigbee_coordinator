on boot do
  if [WLSensor] > 0
    on pumpLe
    timerSet 1 [var3]
    set var4 3
  else
    set var4 0
    off pumpLe
    off pumpTolt
  endif
endon

on time 08:00 do
  if [var4] = 0 and [var6] = 0
    on pumpTolt
    timerSet 1 [var1]
    set var4 1
    timerSet 2 [var5]
  endif
endon

on timer2 do
  if [var4] = 0 and [hour] <= 23 and [hour] >= 8
    on pumpTolt
    timerSet 1 [var1]
    set var4 1
    timerSet 2 [var5]
  endif
endon

on WLSensor do
  if [WLSensor] >= 2 and [var4] = 1
    off pumpTolt
    timerCancel 1
    timerSet 1 [var2]
    set var4 2
  endif
endon

on WLSensor do
  if [WLSensor] <= 0 and [var4] = 3
    off pumpLe
    timerCancel 1
    set var4 0
  endif
endon

on WLeakSensor do
  if [WLeakSensor] >= 1 and [var4] = 1
    off pumpTolt
    timerCancel 1
    set var4 0
    set var6 1
  endif
endon

on timer1 do
  if [var4] = 1
    off pumpTolt
    set var4 0
    set var6 1
  endif
endon

on timer1 do
  if [var4] = 2
    set var4 3
    timerSet 1 [var3]
    on pumpLe
  endif
endon

on timer1 do
  if [var4] = 3
    off pumpLe
    set var4 0
    set var6 1
  endif
endon

on var6 do
  if [var6] = 1
    timerCancel 2
    on HibaKi
  else
    off HibaKi
  endif
endon
